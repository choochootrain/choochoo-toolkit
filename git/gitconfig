[color]
	ui = auto
[user]
	name = Hurshal Patel
	email = hurshal@braintrustdata.com
	signingkey = E20B61AA212C90A2
[credential]
	helper = cache --timeout=3600
[branch]
	autosetuprebase = always
[alias]
	a  = add
	b = branch
	br = branch
	bl = blame
	checkoutautocomplete = checkout
	ch = checkout
	cl = clone
	c  = commit
	d  = diff
	dc = diff --cached
	dt = difftool
	g  = grep
	l  = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	lg = log --graph --abbrev-commit --stat -C --decorate --date=local
	pl = pull
	ps = push
	rb = rebase
	rs = reset
	sh = show
	s  = status
	st = stash
	w  = worktree
	wl = worktree list
[push]
	default = simple
	autoSetupRemote = true
[core]
	excludesfile = ~/.gitignore_global
[diff]
	tool = vimdiff
[difftool]
	prompt = false
[merge]
	conflictstyle = diff3
	tool = nvimdiff
[rerere]
	enabled = true
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[gpg]
	program = gpg
[submodule]
	#recurse = true
	fetchJobs = 10
[init]
	defaultBranch = main
[safe]
	directory = *
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
[pull]
	ff = only
